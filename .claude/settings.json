{
  "mcpServers": {
    "home-assistant": {
      "command": "uvx",
      "args": ["--python", "3.13", "ha-mcp@latest"],
      "env": {
        "HOMEASSISTANT_URL": "https://hisgenpad.molamola.dev",
        "HOMEASSISTANT_TOKEN": "${HOMEASSISTANT_TOKEN}"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
