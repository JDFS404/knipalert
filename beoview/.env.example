# ── Deuropener ────────────────────────────────────────────────────────────────
# URL die wordt aangeroepen om de deur te openen.
#
# Shelly 1 relay (eenvoudigste oplossing voor BeoView Lite 7):
#   Sluit de NO-uitgang van de Shelly aan op de beldrukknop van de videofoon.
#   Stel in: DOOR_OPEN_URL=http://192.168.1.50/relay/0?turn=on&timer=2
#
# 2N intercom (als je een 2N hebt):
#   DOOR_OPEN_URL=http://192.168.1.51/api/switch/ctrl?switch=1&action=trigger
#
# Home Assistant schakelaar:
#   DOOR_OPEN_URL=http://homeassistant.local:8123/api/services/switch/turn_on
#   DOOR_OPEN_METHOD=POST
#   DOOR_OPEN_BODY={"entity_id":"switch.voordeur"}
#
DOOR_OPEN_URL=
DOOR_OPEN_METHOD=GET
DOOR_OPEN_BODY=
DOOR_OPEN_TIMEOUT=5

# ── Beldruk-webhook (optioneel) ───────────────────────────────────────────────
# Stel in je videofoon/relay in dat bij een beldruk een POST gestuurd wordt naar
#   http://<jouw-server>:8080/ring
# met header  X-Ring-Secret: <waarde hieronder>
#
RING_SECRET=verander-dit-in-iets-geheims

# ── Web UI beveiliging (optioneel) ────────────────────────────────────────────
# Stel in om de "Deur open" POST te beveiligen met een Bearer-token.
# Leeg laten = geen auth (gebruik dan alleen op je lokale netwerk).
API_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
HISTORY_SIZE=20
